[sub_resource type="GDScript" id="GDScript_gnh3c"]
resource_name = "training"
script/source = "extends Node2D

func _input(event: InputEvent) -> void:
	if event is InputEventJoypadMotion:
		return
	
	if event.is_action_pressed(&\"avatar_jump_0\"):
		print(\"avatar_jump_0 :: {1}\".format([event.as_text(), event.device]))
	if event.is_action_pressed(&\"avatar_jump_1\"):
		print(\"avatar_jump_1 :: {1}\".format([event.as_text(), event.device]))
"

[sub_resource type="GDScript" id="GDScript_lvrkv"]
resource_name = "state_debug"
script/source = "extends VBoxContainer

@export
var frames: Texture2D

func push_state(frame: int) -> void:
	var rect := TextureRect.new()
	var atlas := AtlasTexture.new()
	atlas.atlas = self.frames
	atlas.region = Rect2((frame % 3) * 64, floor((frame as float / 3.0)) * 32, 64.0, 32.0)
	rect.texture = atlas
	self.add_child(rect)

func on_state(state: int) -> void:
	match state:
		1: # stand
			self.push_state(0)
		2: # walk
			self.push_state(1)
		3: # ground dash
			self.push_state(8)
		4: # air dash
			self.push_state(9)
		5: # jump
			self.push_state(6)
		6: # airjump
			self.push_state(7)
		7: # fall
			self.push_state(5)
		8: # hitstun
			self.push_state(10)
		_:
			pass
"

