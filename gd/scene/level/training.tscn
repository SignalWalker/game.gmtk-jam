[sub_resource type="GDScript" id="GDScript_lvrkv"]
resource_name = "state_debug"
script/source = "extends VBoxContainer

@export
var frames: Texture2D

func _ready() -> void:
	%Avatar.enter_state.connect(self.on_state)

func push_state(frame: int) -> void:
	var rect := TextureRect.new()
	var atlas := AtlasTexture.new()
	atlas.atlas = self.frames
	atlas.region = Rect2((frame % 3) * 64, floor((frame / 3)) * 32, 64.0, 32.0)
	rect.texture = atlas
	self.add_child(rect)

func on_state(state: int) -> void:
	match state:
		1: # stand
			self.push_state(0)
		2: # walk
			self.push_state(1)
		3: # ground dash
			self.push_state(8)
		4: # air dash
			self.push_state(9)
		5: # jump
			self.push_state(6)
		6: # airjump
			self.push_state(7)
		7: # fall
			self.push_state(5)
		8: # hitstun
			self.push_state(10)
		_:
			pass
"

[sub_resource type="GDScript" id="GDScript_gnh3c"]
resource_name = "vel_debug"
script/source = "extends Label

func _ready() -> void:
	self.process_physics_priority = -1

func _physics_process(_delta: float) -> void:
	var gd: Vector2 = %Avatar.velocity
	var i: Vector2 = %Avatar.get_internal_velocity()
	self.text = \"{0}, {1}\\n{2}, {3}\".format([i.x, i.y, gd.x, gd.y])
"

