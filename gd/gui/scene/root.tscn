[gd_scene format=3 uid="uid://i252s7rwmnbl"]

[sub_resource type="GDScript" id="GDScript_o0ebj"]
resource_name = "root"
script/source = "@tool
extends Container

func get_scene_manager_parent() -> Node:
	return %GameViewport

func _notification(what: int) -> void:
	match what:
		NOTIFICATION_SORT_CHILDREN:
			var r := self.get_rect()
			for c: Node in self.get_children():
				if c is Control:
					self.fit_child_in_rect(c as Control, r)
"

[sub_resource type="GDScript" id="GDScript_3cjqm"]
resource_name = "int_con"
script/source = "@tool
extends IntegerScalingContainer

func _init() -> void:
	ProjectSettings.settings_changed.connect(self._on_settings_changed)

func _enter_tree() -> void:
	self._on_settings_changed()

func _ready() -> void:
	self._update_window_size.call_deferred()

func _update_window_size() -> void:
	if Engine.is_editor_hint():
		return

	var win := self.get_window()
	if win != null:
		IntegerScalingContainer.fit_window(win, self.base_size)

func _on_settings_changed() -> void:
	self.base_size = Vector2i(ProjectSettings.get_setting(&\"display/window/size/viewport_width\", 600) as int, ProjectSettings.get_setting(&\"display/window/size/viewport_height\", 450) as int)
"

